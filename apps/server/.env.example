# --- Phase 1 ---
NODE_ENV=development
# Must stay a loopback address (single-user, local-only). The server refuses to start otherwise.
HOST=127.0.0.1
PORT=4000
# Path is relative to apps/server/prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# --- Phase 2 (documented now, NOT read by the code yet) ---
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/qa-generate
# N8N_REQUEST_SECRET=            # backend -> n8n HMAC signing secret (>= 32 chars)
# N8N_CALLBACK_SECRET=           # n8n -> backend callback secret (>= 32 chars)
# PUBLIC_BACKEND_URL=http://127.0.0.1:4000   # base for short-lived evidence URLs
# EVIDENCE_URL_TTL_SECONDS=300
# MAX_UPLOAD_MB=5
# Maximum screenshot upload size in MB
MAX_UPLOAD_MB=5


# --- Phase 2B: n8n integration ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-qa-studio/generate
N8N_REQUEST_SECRET=10ca45efeef58290d43de8f81b17fb09b2e0e553c585c07b09423a6314c9c33f
PUBLIC_BACKEND_URL=http://127.0.0.1:4000
