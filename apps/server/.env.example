# Copy this file to apps/server/.env and fill in the secrets.
# Never commit the real .env (it is in .gitignore).

NODE_ENV=development
# Must stay a loopback address (single-user, local-only). The server refuses to start otherwise.
HOST=127.0.0.1
PORT=4000
# Path is relative to apps/server/prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Maximum screenshot upload size in MB
MAX_UPLOAD_MB=5

# --- n8n integration ---
# Production webhook URL of the imported workflow (the workflow must be active).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-qa-studio/generate
# Sent to n8n in the X-AQS-Request-Secret header; must equal the value of the
# Header Auth credential on the n8n Webhook node. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_REQUEST_SECRET=
# Address n8n uses to download evidence and send results back.
PUBLIC_BACKEND_URL=http://127.0.0.1:4000
# How long signed evidence download links stay valid.
EVIDENCE_URL_TTL_SECONDS=300
# Signs evidence download links for n8n. Required. At least 32 characters.
EVIDENCE_SIGNING_SECRET=

# --- Going live (optional, see README "Run it live on another computer") ---
# Serve the built web app (npm run build) from this server.
WEB_DIST_DIR=
# Public host names allowed besides localhost, e.g. .trycloudflare.com
PUBLIC_HOSTS=
