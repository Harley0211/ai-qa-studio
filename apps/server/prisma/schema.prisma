
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  urls        ProjectURL[]
  evidence    Evidence[]
  testCases   TestCase[]
  generations GenerationRun[]
  nextTestCaseNumber Int @default(1)

  @@index([updatedAt])
}

model ProjectURL {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
}

model Evidence {
  id             String   @id @default(cuid())
  projectId      String
  filename       String
  storedFilename String
  mimeType       String
  fileSize       Int
  storageKey     String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model GenerationRun {
  id          String    @id @default(cuid())
  projectId   String
  status      String    @default("PENDING")
  error       String?
  callbackTokenHash      String?
  callbackTokenExpiresAt DateTime?
  callbackTokenUsedAt    DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TestCase {
  id             String   @id @default(cuid())
  caseId         String
  projectId      String
  generationRunId String?
  title          String
  description    String?
  precondition   String?
  steps          String
  data           String?
  expectedResult String
  stepExpectedResults String?
  runStatus      String   @default("Not Run")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  @@unique([projectId, caseId])
  @@index([projectId, createdAt])
  @@index([generationRunId])
}
