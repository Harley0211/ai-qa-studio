
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person who can sign in. Admins open every project and manage users;
// testers ("MEMBER") only open the projects an admin assigned to them.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lowercased
  name         String
  passwordHash String    // scrypt, see src/modules/auth/auth.passwords.js
  role         String    @default("MEMBER") // "ADMIN" or "MEMBER" (shown as "Tester")
  active       Boolean   @default(true) // a disabled account can't sign in
  lastLoginAt  DateTime? // null: added by an admin and never signed in ("Invited")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  bugReports   BugReport[]
  harFiles     HarFile[]
  projects     ProjectMember[]
}

// A tester assigned to a project. Admins don't need rows here.
model ProjectMember {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// A generated bug report and its folder of files (storage/bug-reports/<id>/).
// Shared with the whole team, like projects.
model BugReport {
  id           String    @id @default(cuid())
  status       String    @default("PENDING") // PENDING, SUCCEEDED, FAILED
  error        String?
  // From the generated report, for the list.
  title        String?
  severity     String?
  affectedArea String?
  // JSON: what the tester entered plus facts from the attachments (HAR
  // errors, image notes), kept so the report can be retried and formatted.
  input        String
  report       String?   // JSON: the generated report
  texts        String?   // JSON: Jira/Slack texts as edited and saved
  projectId    String    // a report belongs to one project and is only shown there
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  files     BugReportFile[]

  @@index([projectId, createdAt])
  @@index([status])
}

model BugReportFile {
  id          String   @id @default(cuid())
  bugReportId String
  name        String
  kind        String   // image, frame, video, har, har-summary
  mimeType    String
  size        Int
  storageKey  String   // relative to the storage root
  aiOrder     Int?     // position among the images sent to the AI (null: not sent)
  createdAt   DateTime @default(now())

  bugReport BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  @@index([bugReportId])
}

// A HAR file opened in the HAR reader, saved (redacted) in its own folder
// (storage/har-files/<id>/).
model HarFile {
  id          String   @id @default(cuid())
  name        String
  size        Int
  summary     String   // JSON: request and error counts, for the list
  storageKey  String
  projectId   String   // only shown in its project
  createdById String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// A signed-in browser. Only a hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  // false: "Remember me" was off (ends with the browser, short expiry, and
  // the app signs out after 30 minutes without activity).
  remember  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  urls        ProjectURL[]
  evidence    Evidence[]
  testCases   TestCase[]
  generations GenerationRun[]
  documents   Document[]
  bugReports  BugReport[]
  harFiles    HarFile[]
  members     ProjectMember[]
  nextTestCaseNumber Int @default(1)

  @@index([updatedAt])
}

model ProjectURL {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
}

model Evidence {
  id             String   @id @default(cuid())
  projectId      String
  filename       String
  storedFilename String
  mimeType       String
  fileSize       Int
  storageKey     String
  createdAt      DateTime @default(now())
  // When a generation that used this image last finished (null: never used).
  // The image tools pre-select only images that were never used.
  lastUsedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model GenerationRun {
  id          String    @id @default(cuid())
  projectId   String
  status      String    @default("PENDING")
  error       String?
  callbackTokenHash      String?
  callbackTokenExpiresAt DateTime?
  callbackTokenUsedAt    DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // Generated cases waiting for review (JSON array). They become TestCase rows
  // only when accepted; null once reviewed (or for runs before review existed).
  draftTestCases String?
  reviewedAt     DateTime?
  // Set when the run was generated from a document section.
  documentId     String?
  sectionTitle   String?
  // The evidence images sent with an image run (JSON array of ids).
  evidenceIds    String?
  // Set on a refinement run (AI chat): the review batch it changes, the
  // user's instruction, and the model's short reply about what it changed.
  refinesRunId   String?
  instruction    String?
  replySummary   String?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  testCases TestCase[]

  @@index([refinesRunId])

  @@index([projectId, createdAt])
  @@index([status])
}

model TestCase {
  id             String   @id @default(cuid())
  caseId         String
  projectId      String
  generationRunId String?
  title          String
  description    String?
  precondition   String?
  steps          String
  data           String?
  expectedResult String
  stepExpectedResults String?
  runStatus      String   @default("Not Run")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // The document section a generated case came from (null for others).
  sourceDocumentId String?
  sourceSection    String?

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRun  GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  sourceDocument Document?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([projectId, caseId])
  @@index([projectId, createdAt])
  @@index([generationRunId])
  @@index([sourceDocumentId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  sourceType String   // "PASTE" or "UPLOAD"
  filename   String?
  content    String
  sections   String   // JSON array of { id, title, text }
  createdAt  DateTime @default(now())

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generations GenerationRun[]
  testCases   TestCase[]

  @@index([projectId, createdAt])
}
