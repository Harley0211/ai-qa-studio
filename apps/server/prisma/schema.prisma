
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person who can sign in. Everyone signed in works on all projects (shared
// team); admins can also add, change and remove users.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lowercased
  name         String
  passwordHash String    // scrypt, see src/modules/auth/auth.passwords.js
  role         String    @default("MEMBER") // "ADMIN" or "MEMBER"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

// A signed-in browser. Only a hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  urls        ProjectURL[]
  evidence    Evidence[]
  testCases   TestCase[]
  generations GenerationRun[]
  documents   Document[]
  nextTestCaseNumber Int @default(1)

  @@index([updatedAt])
}

model ProjectURL {
  id        String   @id @default(cuid())
  projectId String
  label     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
}

model Evidence {
  id             String   @id @default(cuid())
  projectId      String
  filename       String
  storedFilename String
  mimeType       String
  fileSize       Int
  storageKey     String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model GenerationRun {
  id          String    @id @default(cuid())
  projectId   String
  status      String    @default("PENDING")
  error       String?
  callbackTokenHash      String?
  callbackTokenExpiresAt DateTime?
  callbackTokenUsedAt    DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // Generated cases waiting for review (JSON array). They become TestCase rows
  // only when accepted; null once reviewed (or for runs before review existed).
  draftTestCases String?
  reviewedAt     DateTime?
  // Set when the run was generated from a document section.
  documentId     String?
  sectionTitle   String?
  // Set on a refinement run (AI chat): the review batch it changes, the
  // user's instruction, and the model's short reply about what it changed.
  refinesRunId   String?
  instruction    String?
  replySummary   String?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  testCases TestCase[]

  @@index([refinesRunId])

  @@index([projectId, createdAt])
  @@index([status])
}

model TestCase {
  id             String   @id @default(cuid())
  caseId         String
  projectId      String
  generationRunId String?
  title          String
  description    String?
  precondition   String?
  steps          String
  data           String?
  expectedResult String
  stepExpectedResults String?
  runStatus      String   @default("Not Run")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // The document section a generated case came from (null for others).
  sourceDocumentId String?
  sourceSection    String?

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRun  GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  sourceDocument Document?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([projectId, caseId])
  @@index([projectId, createdAt])
  @@index([generationRunId])
  @@index([sourceDocumentId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  sourceType String   // "PASTE" or "UPLOAD"
  filename   String?
  content    String
  sections   String   // JSON array of { id, title, text }
  createdAt  DateTime @default(now())

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generations GenerationRun[]
  testCases   TestCase[]

  @@index([projectId, createdAt])
}
