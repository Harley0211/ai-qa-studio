{
  "name": "ai-qa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20.12" },
  "scripts": {
    "setup": "npm install && npm run db:generate && npm run db:migrate",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @aqs/server",
    "dev:web": "npm run dev -w @aqs/web",
    "db:generate": "npm run db:generate -w @aqs/server",
    "db:migrate": "npm run db:migrate -w @aqs/server",
    "db:studio": "npm run db:studio -w @aqs/server",
    "test": "npm run test -w @aqs/server && npm run test -w @aqs/web",
    "build": "npm run build -w @aqs/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
